---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 100%);
			}

			.home-hero {
				display: grid;
				gap: 2rem;
				align-items: start;
				margin-bottom: 3rem;
			}

			.home-copy {
				max-width: 38rem;
				padding-top: 0;
			}

			.home-eyebrow {
				margin: 0 0 0.75rem;
				font-size: 0.9rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #6b6b6b;
			}

			.home-title {
				margin: 0 0 1rem;
				font-size: clamp(2.5rem, 6vw, 4.5rem);
				line-height: 1.08;
				color: rgb(var(--black));
			}

			.home-description {
				margin: 0 0 1.5rem;
				font-size: 1.02rem;
				line-height: 1.8;
				color: #4f4f4f;
			}

			.home-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.home-actions a {
				display: inline-block;
				padding: 0.75rem 1rem;
				border: 1px solid #d8d2c4;
				border-radius: 999px;
				background: #fff;
				color: rgb(var(--black));
				text-decoration: none;
				transition: background-color 0.2s ease, border-color 0.2s ease;
			}

			.home-actions a:hover {
				background: #f8f6f0;
				border-color: #cfc6b4;
			}

			.home-image {
				margin: 0;
				background: #ffffff;
				border: 1px solid #e3dfd4;
				border-radius: 16px;
				overflow: hidden;
			}

			.home-image img {
				display: block;
				width: 100%;
				height: auto;
			}

			.home-section {
				margin-top: 2rem;
			}

			.section-title {
				margin: 0 0 1rem;
				font-size: 1.25rem;
				line-height: 1.4;
				color: rgb(var(--black));
			}

			.section-card {
				background: #ffffff;
				border: 1px solid #e3dfd4;
				border-radius: 16px;
				padding: 1.25rem;
			}

			.section-card p {
				margin: 0;
				line-height: 1.8;
				color: #4f4f4f;
			}

			@media (min-width: 900px) {
				.home-hero {
					grid-template-columns: 1.05fr 0.95fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="home-hero">
				<div class="home-copy">
					<p class="home-eyebrow">Portfolio / Blog</p>
					<h1 class="home-title">さとしのブログ</h1>
					<p class="home-description">
						承認欲求を満たすためだけに作ったサイトです。
					</p>
					<div class="home-actions">
						<a href="/about">About</a>
						<a href="/blog">Blog</a>
						<a href="/contact">Contact</a>
					</div>
				</div>

				<figure class="home-image">
					<img
						src="/images/home-hero.jpg"
						alt="Home visual"
						width="1200"
						height="900"
					/>
				</figure>
			</section>

			<section class="home-section">
				<h2 class="section-title">About this site</h2>
				<div class="section-card">
					<p>
						社会人よりアイドルオタク歴が長いさとしのサイトです。<br />
						このブログを作ること自体、趣味として技術的なことをしていたり。<br />
						日頃出かけては写真を撮ったり、気が向けば文章を書いてみたり。<br />
						そんな色んなものをつくるのが好きな私のブログを覗いてみませんか？<br />
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>