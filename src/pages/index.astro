---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 5rem 0 6rem;
				text-align: center;
			}

			.hero h1 {
				margin-bottom: 1rem;
				font-size: clamp(2.4rem, 8vw, 4.4rem);
				line-height: 1.15;
			}

			.hero p {
				max-width: 36rem;
				margin: 0 auto;
				color: rgb(var(--gray));
				font-size: 1.05rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>工事中</h1>
				<p>ホームはこれから大きな写真を入れて整えていく予定です。</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
